<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_souvenir_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/np_pending_bar_bg"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp"
    android:visibility="gone">

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/np_round_active_bg"
        android:backgroundTint="#FFFF4F93" />

    <TextView
        android:id="@+id/np_souvenir_bar_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/np_souvenir_bar_cancel"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/np_pending_cancel_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/np_cancel"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
</LinearLayout>
