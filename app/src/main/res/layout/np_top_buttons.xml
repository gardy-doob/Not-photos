<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_top_buttons"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/np_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/np_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/np_logo_flat" />

        <TextView
            android:id="@+id/np_logo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/np_brand"
            android:textColor="#FF3A3330"
            android:textSize="21sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/np_video_filter"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/np_round_bg"
        android:clickable="true"
        android:contentDescription="@string/np_videos"
        android:elevation="4dp"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/ic_np_videos" />

    <ImageView
        android:id="@+id/np_burger"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/np_round_bg"
        android:clickable="true"
        android:contentDescription="@string/np_menu"
        android:elevation="4dp"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/ic_np_menu" />
</LinearLayout>
