<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_nav" android:layout_width="match_parent" android:layout_height="72dp"
    android:layout_gravity="bottom" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="16dp"
    android:background="@drawable/np_nav_bg" android:elevation="8dp" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
    <LinearLayout android:id="@+id/np_nav_gallery" style="@style/NpNavItem" android:contentDescription="@string/np_gallery">
        <ImageView android:id="@+id/np_nav_gallery_icon" style="@style/NpNavIcon" android:src="@drawable/ic_np_gallery" />
        <TextView android:id="@+id/np_nav_gallery_label" style="@style/NpNavLabel" android:text="@string/np_gallery" />
    </LinearLayout>
    <LinearLayout android:id="@+id/np_nav_videos" style="@style/NpNavItem" android:contentDescription="@string/np_videos">
        <ImageView android:id="@+id/np_nav_videos_icon" style="@style/NpNavIcon" android:src="@drawable/ic_np_videos" />
        <TextView android:id="@+id/np_nav_videos_label" style="@style/NpNavLabel" android:text="@string/np_videos" />
    </LinearLayout>
    <LinearLayout android:id="@+id/np_nav_jalons" style="@style/NpNavItem" android:contentDescription="@string/np_jalons">
        <ImageView android:id="@+id/np_nav_jalons_icon" style="@style/NpNavIcon" android:src="@drawable/ic_np_jalon" />
        <TextView android:id="@+id/np_nav_jalons_label" style="@style/NpNavLabel" android:text="@string/np_jalons" />
    </LinearLayout>
    <LinearLayout android:id="@+id/np_nav_all" style="@style/NpNavItem" android:contentDescription="@string/np_all">
        <ImageView android:id="@+id/np_nav_all_icon" style="@style/NpNavIcon" android:src="@drawable/ic_np_all" />
        <TextView android:id="@+id/np_nav_all_label" style="@style/NpNavLabel" android:text="@string/np_all" />
    </LinearLayout>
    <LinearLayout android:id="@+id/np_nav_folders" style="@style/NpNavItem" android:contentDescription="@string/np_folders">
        <ImageView android:id="@+id/np_nav_folders_icon" style="@style/NpNavIcon" android:src="@drawable/ic_np_folders" />
        <TextView android:id="@+id/np_nav_folders_label" style="@style/NpNavLabel" android:text="@string/np_folders" />
    </LinearLayout>
</LinearLayout>
