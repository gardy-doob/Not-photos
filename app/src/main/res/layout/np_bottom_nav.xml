<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_nav"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/np_nav_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginStart="140dp"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/np_nav_toggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/np_round_bg"
            android:clickable="true"
            android:contentDescription="@string/np_toggle_jalons"
            android:elevation="6dp"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_np_souvenir" />

        <LinearLayout
            android:id="@+id/np_nav_pill"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/np_rail_bg"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView android:id="@+id/np_nav_gallery" style="@style/NpRailItem" android:contentDescription="@string/np_gallery" android:src="@drawable/ic_np_gallery" />
            <ImageView android:id="@+id/np_nav_jalons" style="@style/NpRailItem" android:contentDescription="@string/np_jalons" android:src="@drawable/ic_np_albums" />
            <ImageView android:id="@+id/np_nav_all" style="@style/NpRailItem" android:contentDescription="@string/np_all" android:src="@drawable/ic_np_all" />
            <ImageView android:id="@+id/np_nav_folders" style="@style/NpRailItem" android:contentDescription="@string/np_folders" android:src="@drawable/ic_np_folders" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/np_nav_label"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="68dp"
        android:background="@drawable/np_rail_label_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="invisible" />
</FrameLayout>
